            12) proto_menu doh ;;
            0) return 0 ;;
            *) echo "  Opción no válida: $opt"; sleep 1 ;;
        esac
    done
}

# --- [04] GENERADOR DE KEY -------------------------------------------------------
# Las keys se generan aquí y su SHA-256 se publica en el repo (keys.sha256).
# install.sh valida la key contra ese registro. Sin registro publicado, el
# instalador avisa y continúa (modo prueba); con registro, la key es obligatoria.

keygen_generate() {
    local nota days raw key hash creada vence
    echo
    read -rp "  Nota / para quién es (ej. nombre del cliente): " nota || return
    read -rp "  Días de vigencia (0 = sin vencimiento): " days || return
    [[ -z "$days" ]] && days=0
    [[ "$days" =~ ^[0-9]+$ ]] || { echo "  Días no válidos."; return; }
    raw="$(tr -dc 'A-Z2-9' < /dev/urandom | head -c 16)"
    key="MUSTAFA-${raw:0:4}-${raw:4:4}-${raw:8:4}-${raw:12:4}"
    hash="$(printf '%s' "$key" | sha256sum | awk '{print $1}')"
    creada="$(date +%Y-%m-%d)"
    if [[ "$days" -gt 0 ]]; then
        vence="$(date -d "+$days days" +%Y-%m-%d)"
    else
        vence="nunca"
    fi
    mkdir -p "$KEYS_DIR"; chmod 700 "$KEYS_DIR"
    printf '%s|%s|%s|%s|activa\n' "$key" "${nota:-sin nota}" "$creada" "$vence" >> "$KEYS_DB"
    chmod 600 "$KEYS_DB"
    printf '%s\n' "$hash" >> "$KEYS_HASHES"
    chmod 600 "$KEYS_HASHES"
    echo
    printf '  KEY generada: %b%s%b\n' "$C_YELLOW" "$key" "$C_RESET"
    printf '  Para: %s | Vence: %s\n' "${nota:-sin nota}" "$vence"
    echo
    echo "  Pásale esa KEY a quien va a instalar. Para que el instalador la"
    echo "  acepte, exporta los hashes (opción 4) y súbelos como keys.sha256"
    echo "  a la raíz de titlan/v2install."
}

keygen_list() {
    local n=0 k nota creada vence estado
    echo
    if [[ ! -f "$KEYS_DB" ]]; then
        echo "  (sin keys generadas todavía)"
        return
    fi
    printf '  %-4s %-26s %-16s %-12s %-10s %-9s\n' "#" "KEY" "PARA" "CREADA" "VENCE" "ESTADO"
    while IFS='|' read -r k nota creada vence estado; do
        [[ -z "$k" ]] && continue
        n=$((n+1))
        printf '  %-4s %-26s %-16s %-12s %-10s %-9s\n' "$n" "$k" "${nota:0:16}" "$creada" "$vence" "$estado"
    done < "$KEYS_DB"
    [[ $n -eq 0 ]] && echo "  (sin keys generadas todavía)"
    echo
    printf '  Total: %s key(s)\n' "$n"
}

keygen_revoke() {
    local n total line key hash tmp
    total=0
    [[ -f "$KEYS_DB" ]] && total="$(grep -c . "$KEYS_DB" 2>/dev/null || echo 0)"
    [[ "$total" -eq 0 ]] && { echo "  (sin keys generadas todavía)"; return; }
    keygen_list
    echo
    read -rp "  Número de la KEY a revocar: " n || return
    [[ "$n" =~ ^[0-9]+$ ]] && [[ $n -ge 1 && $n -le $total ]] || { echo "  Número no válido."; return; }
    line="$(sed -n "${n}p" "$KEYS_DB")"
    key="$(printf '%s' "$line" | cut -d'|' -f1)"
    hash="$(printf '%s' "$key" | sha256sum | awk '{print $1}')"
    tmp="$(mktemp)"
    awk -F'|' -v n="$n" 'BEGIN{OFS="|"} NR==n{$5="revocada"} {print}' "$KEYS_DB" > "$tmp" && mv "$tmp" "$KEYS_DB"
    if [[ -f "$KEYS_HASHES" ]]; then
        grep -v "^${hash}$" "$KEYS_HASHES" > "$tmp" && mv "$tmp" "$KEYS_HASHES"
    fi
    echo "  KEY revocada: $key"
    echo "  Recuerda exportar los hashes (opción 4) y actualizar keys.sha256 en el repo."
}

keygen_export() {
    local n=0
    echo
    if [[ -f "$KEYS_HASHES" ]]; then
        n="$(grep -c . "$KEYS_HASHES" 2>/dev/null || echo 0)"
    fi
    printf '  Hashes activos: %s\n' "$n"
    echo
    echo "  Contenido de keys.sha256 (súbelo a la raíz de titlan/v2install):"
    echo "  ----------------------------------------------------------------"
    [[ -f "$KEYS_HASHES" ]] && cat "$KEYS_HASHES" | sed 's/^/  /'
    echo "  ----------------------------------------------------------------"
    echo
    echo "  install.sh valida cada KEY contra:"
    echo "  https://raw.githubusercontent.com/titlan/v2install/main/keys.sha256"
}

keygen_menu() {
    local opt total
    while true; do
        clear
        total=0
        [[ -f "$KEYS_DB" ]] && total="$(grep -c . "$KEYS_DB" 2>/dev/null || echo 0)"
        printf '%b\n  ============ GENERADOR DE KEY ============\n%b' "$C_CYAN_B" "$C_RESET"
        printf '  Keys generadas: %s\n' "$total"
        echo
        printf '  [1] Generar nueva KEY\n'
        printf '  [2] Listar KEYS\n'
        printf '  [3] Revocar KEY\n'
        printf '  [4] Exportar hashes (para subir al repo)\n'
        printf '  [0] Volver\n'
        echo
        read -rp "  Seleccione una opción: " opt || return 0
        case "$opt" in
            1) keygen_generate; pause ;;
            2) keygen_list; pause ;;
            3) keygen_revoke; pause ;;
            4) keygen_export; pause ;;
            0) return 0 ;;
            *) echo "  Opción no válida: $opt"; sleep 1 ;;
        esac
    done
}

# --- [05] HERRAMIENTAS ---------------------------------------------------------
# Fail2Ban + BBR + vnStat + respaldo + bot WhatsApp (Knightbot).
# El instalador es install/herramientas.sh (se copia a /etc/mustafa/install/
# con install.sh) y el respaldo es /usr/local/bin/mustafa-backup.
# El bot WhatsApp es install/knightbot.sh (se instala desde este menú).
herramientas_menu() {
    local opt st_f2b st_bbr st_vn last_bk st_wa
    while true; do
        clear
        st_f2b="--"; st_vn="--"; last_bk="ninguno"; st_wa="--"
        if command -v systemctl >/dev/null 2>&1; then
            systemctl is-active --quiet fail2ban 2>/dev/null && st_f2b="ON"
            systemctl is-active --quiet vnstat 2>/dev/null && st_vn="ON"
            systemctl is-active --quiet knightbot 2>/dev/null && st_wa="ON"
        fi
        st_bbr="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "?")"
        last_bk="$(ls -t /root/mustafa-backup-*.tar.gz 2>/dev/null | head -n 1 || true)"
        [[ -n "$last_bk" ]] && last_bk="$(basename "$last_bk")"
        printf '%b\n  ============ HERRAMIENTAS 🔐 ============\n%b' "$C_CYAN_B" "$C_RESET"
        printf '  Fail2Ban : %s\n' "$st_f2b"
        printf '  BBR      : %s\n' "$st_bbr"
        printf '  vnStat   : %s\n' "$st_vn"
        printf '  Respaldo : %s\n' "$last_bk"
        printf '  Bot WhatsApp: %s\n' "$st_wa"
        echo
        printf '  [1] Instalar herramientas (Fail2Ban + BBR + vnStat + respaldo)\n'
        printf '  [2] Crear respaldo ahora\n'
        printf '  [3] Ver tráfico (vnstat)\n'
        printf '  [4] Ver baneos de Fail2Ban\n'
        printf '  [5] Instalar bot WhatsApp (Knightbot)\n'
        printf '  [6] Ver código de pareo del bot\n'
        printf '  [7] Ver log del bot\n'
        printf '  [8] Desinstalar bot WhatsApp\n'
        printf '  [0] Volver\n'
        echo
        read -rp "  Seleccione una opción: " opt || return 0
        case "$opt" in
            1)
                if [[ -f "$INSTALL_DIR/herramientas.sh" ]]; then
                    bash "$INSTALL_DIR/herramientas.sh"
                else
                    echo
                    echo "  No está el instalador $INSTALL_DIR/herramientas.sh."
                    echo "  Reinstala el menú con install.sh (copia install/ a /etc/mustafa/install/)."
                fi
                pause ;;
            2)
                if [[ -x /usr/local/bin/mustafa-backup ]]; then
                    echo; /usr/local/bin/mustafa-backup
                else
                    echo; echo "  El respaldo no está instalado. Corre primero [1]."
                fi
                pause ;;
            3)
                echo; vnstat 2>/dev/null || echo "  vnStat no está instalado. Corre primero [1]."
                pause ;;
            4)
                echo; fail2ban-client status sshd 2>/dev/null || echo "  Fail2Ban no está instalado. Corre primero [1]."
                pause ;;
            5)
                if [[ -f "$INSTALL_DIR/knightbot.sh" ]]; then
                    bash "$INSTALL_DIR/knightbot.sh"
                else
                    echo
                    echo "  No está el instalador $INSTALL_DIR/knightbot.sh."
                    echo "  Reinstala el menú con install.sh (copia install/ a /etc/mustafa/install/)."
                fi
                pause ;;
            6)
                echo
                if systemctl is-active --quiet knightbot 2>/dev/null; then
                    local code
                    code="$(journalctl -u knightbot -n 200 -o cat --no-pager 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -oE '[A-Za-z0-9]{4}-[A-Za-z0-9]{4}' | tail -n 1 || true)"
                    if [[ -n "$code" ]]; then
                        echo "  Código de pareo: $code"
                        echo "  En WhatsApp: Ajustes > Dispositivos vinculados > Vincular dispositivo"
                        echo "  e introduce el código. Caduca en pocos minutos."
                    elif journalctl -u knightbot -n 100 -o cat --no-pager 2>/dev/null | grep -q "Failed to get pairing code"; then
                        echo "  El bot no pudo pedir el código (no conecta con WhatsApp)."
                        echo "  Revisa el log con [7] y tu internet; luego reinicia el servicio:"
                        echo "    systemctl restart knightbot"
                    else
                        echo "  No hay código de pareo reciente."
                        echo "  Si el bot ya está vinculado, no lo necesita."
                        echo "  Si no lo está, reinicia el servicio y vuelve aquí:"
                        echo "    systemctl restart knightbot"
                    fi
                else
                    echo "  El bot no está instalado o no está activo. Corre primero [5]."
                fi
                pause ;;
            7)
                echo; journalctl -u knightbot -n 40 --no-pager 2>/dev/null || echo "  El bot no está instalado. Corre primero [5]."
                pause ;;
            8)
                echo
                read -rp "  ¿Desinstalar el bot WhatsApp (se borra la sesión)? [s/N]: " opt2 || opt2=""
                if [[ "$opt2" == "s" || "$opt2" == "S" ]]; then
                    if [[ -f "$INSTALL_DIR/knightbot.sh" ]]; then
                        bash "$INSTALL_DIR/knightbot.sh" --uninstall
                    else
                        echo "  No está el instalador $INSTALL_DIR/knightbot.sh."
                    fi
                else
                    echo "  Cancelado."
                fi
                pause ;;
            0) return 0 ;;
            *) echo "  Opción no válida: $opt"; sleep 1 ;;
        esac
    done
}

# --- Bucle principal ---------------------------------------------------------------
main() {
    [[ $EUID -eq 0 ]] || echo "  Aviso: el menú se debe ejecutar como root para ver todos los datos."
    while true; do
        draw_header
        draw_menu
        read -rp "  Seleccione una opción: " opt || exit 0
        case "$opt" in
            01|1) ssh_menu ;;
            02|2) v2ray_menu ;;
            03|3) protocols_menu ;;
            04|4) keygen_menu ;;
            05|5) herramientas_menu ;;
            00|0) clear; echo "  Hasta luego."; exit 0 ;;
            88)   do_reboot ;;
            *)    echo "  Opción no válida: $opt"; sleep 1 ;;
        esac
    done
}

main "$@"
